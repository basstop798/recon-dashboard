# BulletRecon configuration.
#
# Every value here is optional: with none of them set the app runs wide open on
# localhost, which is the right default for `next dev`. For anything reachable
# from the internet, set at least the two auth variables.
#
# Copy to `.env.local` for local use, or paste into your host's environment
# settings (on Vercel: Project -> Settings -> Environment Variables).

# ── Access control ───────────────────────────────────────────────────────────
# Both must be set to enable HTTP Basic auth on every route, API included.
# Unset = no authentication at all. Generate the password with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
#
# Stick to ASCII. Browsers send these as UTF-8 (the server asks for it), but
# some command-line clients on Windows re-encode non-ASCII characters and will
# then fail to authenticate against a password the browser accepts.
BULLETRECON_AUTH_USER=
BULLETRECON_AUTH_PASSWORD=

# ── Abuse controls ───────────────────────────────────────────────────────────
# Scans per client per window (default 5).
BULLETRECON_RATE_PER_CLIENT=
# Scans across all clients per window (default 60). Header spoofing cannot
# get around this one.
BULLETRECON_RATE_PER_INSTANCE=
# Window length in milliseconds (default 600000, i.e. 10 minutes).
BULLETRECON_RATE_WINDOW_MS=
# Simultaneous in-flight scans (default 3). This is what protects CPU, sockets
# and the platform's execution limit.
BULLETRECON_MAX_CONCURRENT=

# ── Networking ───────────────────────────────────────────────────────────────
# Set to "false" when the app is exposed directly to the internet with no proxy
# in front. Forwarding headers are attacker-controlled unless a proxy you trust
# overwrites them; "false" puts every caller in one bucket — strict but honest.
# Leave unset on Vercel, which sets x-forwarded-for itself.
BULLETRECON_TRUST_PROXY=

# Extra origins allowed to call the API cross-site, comma separated. Only needed
# if you front the app with a different hostname than it is served from.
BULLETRECON_ALLOWED_ORIGINS=

# Comma-separated resolver IPs for the DNS module, e.g. "1.1.1.1,8.8.8.8".
# Only needed where the host has no usable resolver of its own — a container
# with a stub resolv.conf, or a machine pointing at a local resolver that is not
# running (the DNS tab then reports "No usable DNS resolver"). Deliberately not
# defaulted: a public resolver would see every target you scan.
BULLETRECON_DNS_SERVERS=
